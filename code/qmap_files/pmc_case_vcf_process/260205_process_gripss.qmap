[pre]
. "/home/$USER/miniconda3/etc/profile.d/conda.sh"
conda activate rhabdoids
[params]
cores = 1
memory = 8G
[jobs]
python /data/bbg/projects/rhabdoid_tumors/code/python_scripts/process_gridds.py -i /data/bbg/datasets/rhabdoid_tumors/pmc_case/oncoanalyser_results/output/PMC0101/purple/DIAF.purple.sv.germline.vcf.gz -o /data/bbg/projects/rhabdoid_tumors/mafs_pmc/PMC01/BLOOD/process_sv/gripss/ -gp /data/bbg/projects/rhabdoid_tumors/data/ensembl111_genomic_regions_mane.tsv.gz -mt /data/bbg/datasets/mane_transcripts/mane_transcripts/data/MANE.GRCh38.v1.2.summary.txt.gz -n_id BLOOD --is_germline
