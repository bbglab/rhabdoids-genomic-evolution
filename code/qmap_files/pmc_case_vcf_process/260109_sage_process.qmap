[pre]
. "/home/$USER/miniconda3/etc/profile.d/conda.sh"
conda activate rhabdoids
[params]
cores = 1
memory = 20G
[jobs]
python /data/bbg/projects/rhabdoid_tumors/code/python_scripts/process_sage_vcf.py -i /data/bbg/datasets/rhabdoid_tumors/pmc_case/oncoanalyser_results/output/PMC0101/sage/somatic/DIAF.sage.somatic.vcf.gz -o /data/bbg/projects/rhabdoid_tumors/mafs_pmc/PMC01/DIAF_vs_BLOOD/vcf_processing/sage/ -t_id DIAF -n_id BLOOD
python /data/bbg/projects/rhabdoid_tumors/code/python_scripts/process_sage_vcf.py -i /data/bbg/datasets/rhabdoid_tumors/pmc_case/oncoanalyser_results/output/PMC0102/sage/somatic/OMEN.sage.somatic.vcf.gz -o /data/bbg/projects/rhabdoid_tumors/mafs_pmc/PMC01/OMEN_vs_BLOOD/vcf_processing/sage/ -t_id OMEN -n_id BLOOD
python /data/bbg/projects/rhabdoid_tumors/code/python_scripts/process_sage_vcf.py -i /data/bbg/datasets/rhabdoid_tumors/pmc_case/oncoanalyser_results/output/PMC0103/sage/somatic/LN.sage.somatic.vcf.gz -o /data/bbg/projects/rhabdoid_tumors/mafs_pmc/PMC01/LN_vs_BLOOD/vcf_processing/sage/ -t_id LN -n_id BLOOD
python /data/bbg/projects/rhabdoid_tumors/code/python_scripts/process_sage_vcf.py -i /data/bbg/datasets/rhabdoid_tumors/pmc_case/oncoanalyser_results/output/PMC0104/sage/somatic/LNMETA.sage.somatic.vcf.gz -o /data/bbg/projects/rhabdoid_tumors/mafs_pmc/PMC01/LNMETA_vs_BLOOD/vcf_processing/sage/ -t_id LNMETA -n_id BLOOD
python /data/bbg/projects/rhabdoid_tumors/code/python_scripts/process_sage_vcf.py -i /data/bbg/datasets/rhabdoid_tumors/pmc_case/oncoanalyser_results/output/PMC0105/sage/somatic/HK.sage.somatic.vcf.gz -o /data/bbg/projects/rhabdoid_tumors/mafs_pmc/PMC01/HK_vs_BLOOD/vcf_processing/sage/ -t_id HK -n_id BLOOD
