[pre]
. "/home/$USER/miniconda3/etc/profile.d/conda.sh"
conda activate samtools
[params]
cores = 32
memory = 200G
[jobs]
samtools view -b --threads 32 --reference /data/bbg/datasets/genomes/GRCh38/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna.fa -o /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/preprocessing/recalibrated/BLOOD/BLOOD.recal.bam /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/preprocessing/recalibrated/BLOOD/BLOOD.recal.cram
samtools view -b --threads 32 --reference /data/bbg/datasets/genomes/GRCh38/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna.fa -o /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/preprocessing/recalibrated/DIAF/DIAF.recal.bam /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/preprocessing/recalibrated/DIAF/DIAF.recal.cram
samtools view -b --threads 32 --reference /data/bbg/datasets/genomes/GRCh38/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna.fa -o /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/preprocessing/recalibrated/HK/HK.recal.bam /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/preprocessing/recalibrated/HK/HK.recal.cram
samtools view -b --threads 32 --reference /data/bbg/datasets/genomes/GRCh38/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna.fa -o /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/preprocessing/recalibrated/LN/LN.recal.bam /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/preprocessing/recalibrated/LN/LN.recal.cram
samtools view -b --threads 32 --reference /data/bbg/datasets/genomes/GRCh38/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna.fa -o /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/preprocessing/recalibrated/LNMETA/LNMETA.recal.bam /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/preprocessing/recalibrated/LNMETA/LNMETA.recal.cram
