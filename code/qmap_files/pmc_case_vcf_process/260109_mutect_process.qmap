[pre]
. "/home/$USER/miniconda3/etc/profile.d/conda.sh"
conda activate rhabdoids
[params]
cores = 1
memory = 20G
[jobs]
python /data/bbg/projects/rhabdoid_tumors/code/python_scripts/process_mutect_vcf.py -i /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/variant_calling/mutect2/DIAF_vs_BLOOD/DIAF_vs_BLOOD.mutect2.filtered.vcf.gz -o /data/bbg/projects/rhabdoid_tumors/mafs_pmc/PMC01/DIAF_vs_BLOOD/vcf_processing/mutect/ -t_id PMC01_DIAF -n_id PMC01_BLOOD
python /data/bbg/projects/rhabdoid_tumors/code/python_scripts/process_mutect_vcf.py -i /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/variant_calling/mutect2/OMEN_vs_BLOOD/OMEN_vs_BLOOD.mutect2.filtered.vcf.gz -o /data/bbg/projects/rhabdoid_tumors/mafs_pmc/PMC01/OMEN_vs_BLOOD/vcf_processing/mutect/ -t_id PMC01_OMEN -n_id PMC01_BLOOD
python /data/bbg/projects/rhabdoid_tumors/code/python_scripts/process_mutect_vcf.py -i /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/variant_calling/mutect2/LN_vs_BLOOD/LN_vs_BLOOD.mutect2.filtered.vcf.gz -o /data/bbg/projects/rhabdoid_tumors/mafs_pmc/PMC01/LN_vs_BLOOD/vcf_processing/mutect/ -t_id PMC01_LN -n_id PMC01_BLOOD
python /data/bbg/projects/rhabdoid_tumors/code/python_scripts/process_mutect_vcf.py -i /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/variant_calling/mutect2/LNMETA_vs_BLOOD/LNMETA_vs_BLOOD.mutect2.filtered.vcf.gz -o /data/bbg/projects/rhabdoid_tumors/mafs_pmc/PMC01/LNMETA_vs_BLOOD/vcf_processing/mutect/ -t_id PMC01_LNMETA -n_id PMC01_BLOOD
python /data/bbg/projects/rhabdoid_tumors/code/python_scripts/process_mutect_vcf.py -i /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/variant_calling/mutect2/HK_vs_BLOOD/HK_vs_BLOOD.mutect2.filtered.vcf.gz -o /data/bbg/projects/rhabdoid_tumors/mafs_pmc/PMC01/HK_vs_BLOOD/vcf_processing/mutect/ -t_id PMC01_HK -n_id PMC01_BLOOD
