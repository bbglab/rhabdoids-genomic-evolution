[pre]
. "/home/$USER/miniconda3/etc/profile.d/conda.sh"
conda activate samtools
[params]
cores = 32
memory = 200G
[jobs]
samtools index -@ 32 /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/preprocessing/recalibrated/BLOOD/BLOOD.recal.bam -o /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/preprocessing/recalibrated/BLOOD/BLOOD.recal.bai
samtools index -@ 32 /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/preprocessing/recalibrated/DIAF/DIAF.recal.bam -o /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/preprocessing/recalibrated/DIAF/DIAF.recal.bai
samtools index -@ 32 /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/preprocessing/recalibrated/HK/HK.recal.bam -o /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/preprocessing/recalibrated/HK/HK.recal.bai
samtools index -@ 32 /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/preprocessing/recalibrated/LN/LN.recal.bam -o /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/preprocessing/recalibrated/LN/LN.recal.bai
samtools index -@ 32 /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/preprocessing/recalibrated/LNMETA/LNMETA.recal.bam -o /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/preprocessing/recalibrated/LNMETA/LNMETA.recal.bai
samtools index -@ 32 /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/preprocessing/recalibrated/OMEN/OMEN.recal.bam -o /data/bbg/datasets/rhabdoid_tumors/pmc_case/sarek_results/preprocessing/recalibrated/OMEN/OMEN.recal.bai
