python /data/bbg/projects/rhabdoid_tumors/code/python_scripts/intersect_callers2.py -sa /data/bbg/projects/rhabdoid_tumors/mafs_pmc/PMC01/HK_vs_BLOOD/vcf_processing/sage/HK_vs_BLOOD_process.maf.gz -mu /data/bbg/projects/rhabdoid_tumors/mafs_pmc/PMC01/HK_vs_BLOOD/vcf_processing/mutect/HK_vs_BLOOD_process.maf.gz -st /data/bbg/projects/rhabdoid_tumors/mafs_pmc/PMC01/HK_vs_BLOOD/vcf_processing/strelka/HK_vs_BLOOD_process.maf.gz -o /data/bbg/projects/rhabdoid_tumors/mafs_pmc/PMC01/HK_vs_BLOOD/vcf_processing/intersect/ -sn HK_vs_BLOOD -c 
