[pre]
. "/home/$USER/miniconda3/etc/profile.d/conda.sh"
conda activate rhabdoids
[params]
cores = 8
memory = 15G
[jobs]
python /data/bbg/projects/rhabdoid_tumors/code/python_scripts/process_vep111.py --path_input_vep /data/bbg/projects/rhabdoid_tumors/mafs_pmc/PMC01/DIAF_vs_BLOOD/vep_processing/ --path_input_maf /data/bbg/projects/rhabdoid_tumors/mafs_pmc/PMC01/DIAF_vs_BLOOD/vcf_processing/intersect/ --file_name DIAF_vs_BLOOD --cores 8
