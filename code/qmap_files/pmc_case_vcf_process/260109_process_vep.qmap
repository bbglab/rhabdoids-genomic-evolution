python /data/bbg/projects/rhabdoid_tumors/code/python_scripts/process_vep111.py --path_input_vep /data/bbg/projects/rhabdoid_tumors/mafs_pmc/PMC01/LN_vs_BLOOD/vep_processing/ --path_input_maf /data/bbg/projects/rhabdoid_tumors/mafs_pmc/PMC01/LN_vs_BLOOD/vcf_processing/intersect/ --file_name LN_vs_BLOOD --cores 8
python /data/bbg/projects/rhabdoid_tumors/code/python_scripts/process_vep111.py --path_input_vep /data/bbg/projects/rhabdoid_tumors/mafs_pmc/PMC01/LNMETA_vs_BLOOD/vep_processing/ --path_input_maf /data/bbg/projects/rhabdoid_tumors/mafs_pmc/PMC01/LNMETA_vs_BLOOD/vcf_processing/intersect/ --file_name LNMETA_vs_BLOOD --cores 8
