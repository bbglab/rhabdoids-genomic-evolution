[pre]
. "/home/$USER/miniconda3/etc/profile.d/conda.sh"
conda activate rhabdoids
[params]
cores = 1
memory = 20G
[jobs]
singularity exec -B /data/bbg/datasets/vep:/opt/vep/.vep -B /data/bbg/datasets/gnomad/data/v4.0/hg38:/hg38 -B /data/bbg/projects/rhabdoid_tumors/mafs_sarek_oncoa_stjude:/mafs_sarek_oncoa_stjude /data/bbg/datasets/vep/homo_sapiens/ensembl-vep_111.0.sif vep -i /mafs_sarek_oncoa_stjude/SJ030128/SJBT030128_G1/vcf_processing/haplotype_caller/SJBT030128_chr1.maf.gz --format vcf -o /mafs_sarek_oncoa_stjude/SJ030128/SJBT030128_G1/vep_processing/haplotype_caller/SJBT030128_chr1_vep.tsv -tab --assembly GRCh38 --no_stats --cache --symbol --protein --canonical --offline --mane --af_1kg --dir /opt/vep/.vep  --custom /hg38/gnomad.genomes.v4.0.sites.chr1.vcf.bgz,gnomADg,vcf,exact,0,AF,NFE
