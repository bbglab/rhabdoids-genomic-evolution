[pre]
. "/home/$USER/miniconda3/etc/profile.d/conda.sh"
conda activate samtools
[params]
cores = 32
memory = 100G
[jobs]
samtools sort -@ 32 -n /data/bbg/nobackup2/rhabdoids/stjude_rhabdoid_bams/bams/SJBT032047_G1.WholeGenome.bam -o /scratch/bbg/stjude_bams/sorted/SJBT032047_G1.sorted.bam
samtools sort -@ 32 -n /data/bbg/nobackup2/rhabdoids/stjude_rhabdoid_bams/bams/SJBT032047_D1.WholeGenome.bam -o /scratch/bbg/stjude_bams/sorted/SJBT032047_D1.sorted.bam
