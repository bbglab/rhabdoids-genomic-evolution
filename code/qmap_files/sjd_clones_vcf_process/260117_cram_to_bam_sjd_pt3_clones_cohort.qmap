[pre]
. "/home/$USER/miniconda3/etc/profile.d/conda.sh"
conda activate samtools
[params]
cores = 32
memory = 200G
[jobs]
samtools view -b --threads 32 --reference /data/bbg/datasets/genomes/GRCh38/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna.fa -o /data/bbg/datasets/rhabdoid_tumors/sjd_cohort/sarek_results/preprocessing/recalibrated/AX4946/AX4946.recal.bam /data/bbg/datasets/rhabdoid_tumors/sjd_cohort/sarek_results/preprocessing/recalibrated/AX4946/AX4946.recal.cram
samtools view -b --threads 32 --reference /data/bbg/datasets/genomes/GRCh38/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna.fa -o /data/bbg/datasets/rhabdoid_tumors/sjd_cohort/sarek_results/preprocessing/recalibrated/AX4947/AX4947.recal.bam /data/bbg/datasets/rhabdoid_tumors/sjd_cohort/sarek_results/preprocessing/recalibrated/AX4947/AX4947.recal.cram
