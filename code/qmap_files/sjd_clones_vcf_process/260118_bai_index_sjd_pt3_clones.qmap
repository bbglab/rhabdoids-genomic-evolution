[pre]
. "/home/$USER/miniconda3/etc/profile.d/conda.sh"
conda activate samtools
[params]
cores = 32
memory = 200G
[jobs]
samtools index -@ 32 /data/bbg/datasets/rhabdoid_tumors/sjd_cohort/sarek_results/preprocessing/recalibrated/AX4946/AX4946.recal.bam -o /data/bbg/datasets/rhabdoid_tumors/sjd_cohort/sarek_results/preprocessing/recalibrated/AX4946/AX4946.recal.bai
samtools index -@ 32 /data/bbg/datasets/rhabdoid_tumors/sjd_cohort/sarek_results/preprocessing/recalibrated/AX4947/AX4947.recal.bam -o /data/bbg/datasets/rhabdoid_tumors/sjd_cohort/sarek_results/preprocessing/recalibrated/AX4947/AX4947.recal.bai
