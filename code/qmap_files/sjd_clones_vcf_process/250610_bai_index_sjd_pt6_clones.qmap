samtools index -@ 32 /data/bbg/datasets/rhabdoid_tumors/sjd_cohort/sarek_results/preprocessing/recalibrated/AX4942/AX4942.recal.bam -o /data/bbg/datasets/rhabdoid_tumors/sjd_cohort/sarek_results/preprocessing/recalibrated/AX4942/AX4942.recal.bai
samtools index -@ 32 /data/bbg/datasets/rhabdoid_tumors/sjd_cohort/sarek_results/preprocessing/recalibrated/AX4943/AX4943.recal.bam -o /data/bbg/datasets/rhabdoid_tumors/sjd_cohort/sarek_results/preprocessing/recalibrated/AX4943/AX4943.recal.bai
