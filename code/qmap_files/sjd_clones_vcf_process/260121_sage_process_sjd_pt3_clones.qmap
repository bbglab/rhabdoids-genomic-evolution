[pre]
. "/home/$USER/miniconda3/etc/profile.d/conda.sh"
conda activate rhabdoids
[params]
cores = 1
memory = 20G
[jobs]
python /data/bbg/projects/rhabdoid_tumors/code/python_scripts/process_sage_vcf.py -i /data/bbg/datasets/rhabdoid_tumors/sjd_cohort/oncoanalyser_results/output/pt3_1_1/sage/somatic/AX4946.sage.somatic.vcf.gz -o /data/bbg/projects/rhabdoid_tumors/mafs_sjd/pt3/AX4946_vs_AX4895/vcf_processing/sage/ -t_id AX4946 -n_id AX4895
python /data/bbg/projects/rhabdoid_tumors/code/python_scripts/process_sage_vcf.py -i /data/bbg/datasets/rhabdoid_tumors/sjd_cohort/oncoanalyser_results/output/pt3_1_2/sage/somatic/AX4947.sage.somatic.vcf.gz -o /data/bbg/projects/rhabdoid_tumors/mafs_sjd/pt3/AX4947_vs_AX4895/vcf_processing/sage/ -t_id AX4947 -n_id AX4895
